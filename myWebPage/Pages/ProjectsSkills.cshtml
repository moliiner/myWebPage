@page
@model ProjectsSkillsModel
@{
    ViewData["Title"] = "Projects & Skills";
}

<!-- Add Devicon CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

<div class="container page-container">
    <h1 class="section-title" data-i18n="projects.title">PROJECTS &amp; SKILLS</h1>

    <!-- Projects Section -->
    <div class="row justify-content-center" id="projects">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-column-reverse flex-md-row align-items-md-center gap-3">
                        <div class="flex-grow-1 w-100">
                            <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                <h4 class="fw-bold mb-0" data-i18n="projects.project1.title">AI-Powered Job Search Automation</h4>
                                <span class="status-badge status-badge--personal mb-0"><i class="bi bi-person"></i><span data-i18n="projects.origin.personal">Personal Project</span></span>
                            </div>
                            <p class="text-muted mb-3" data-i18n="projects.project1.description">
                                Python pipeline that integrates external APIs, uses an LLM to evaluate and score information
                                in a structured way, stores historical results, and presents them in an interactive dashboard
                                with automatic notifications.
                            </p>
                        </div>
                        <div class="flex-shrink-0 d-flex justify-content-center">
                            <img src="~/img/logo - job_tracker_korea.jpeg" alt="Job Tracker Korea" class="avatar-logo avatar-logo--large">
                        </div>
                    </div>
                    <div class="tech-pills">
                        <span class="tech-pill"><i class="devicon-python-plain"></i> Python</span>
                        <span class="tech-pill">REST APIs</span>
                        <span class="tech-pill">LLM Integration</span>
                        <span class="tech-pill"><i class="devicon-streamlit-plain"></i> Streamlit</span>
                        <span class="tech-pill">Data Pipelines</span>
                        <span class="tech-pill">Telegram Bot API</span>
                    </div>
                    <a href="https://github.com/moliiner/job_tracker_korea" class="btn btn-outline-primary btn-sm mt-3" target="_blank" rel="noopener noreferrer" data-i18n="common.explore">EXPLORE</a>

                    <!-- Job Tracker korea screenshots carousel -->
                    <div id="jobTrackerCarousel" class="carousel slide project-carousel mt-4" data-bs-ride="false" data-bs-interval="false">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#jobTrackerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#jobTrackerCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#jobTrackerCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                            <button type="button" data-bs-target="#jobTrackerCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
                        </div>
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="~/img/Webpage - job_tracker_korea.jpg" class="d-block w-100" alt="Webpage - job_tracker_korea">
                            </div>
                            <div class="carousel-item">
                                <img src="~/img/Telegram bot - job_tracker_korea.jpeg" class="d-block w-100" alt="Telegram bot - job_tracker_korea">
                            </div>
                            <div class="carousel-item">
                                <img src="~/img/Execution VSCode - job_tracker_korea.jpg" class="d-block w-100" alt="Execution VSCode - job_tracker_korea">
                            </div>
                            <div class="carousel-item">
                                <img src="~/img/pipeline_diagram - job_tracker_korea.png" class="d-block w-100" alt="pipeline_diagram - job_tracker_korea">
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#jobTrackerCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#jobTrackerCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                        <h4 class="fw-bold mb-0" data-i18n="projects.project2.title">Product Format Management Tool</h4>
                        <span class="status-badge mb-0"><i class="bi bi-briefcase"></i><span data-i18n="projects.origin.work">STN Cerámica</span></span>
                    </div>
                    <p class="text-muted mb-3" data-i18n="projects.project2.description">
                        Internal .NET application with role-based access control that securely manages the critical
                        master data of 2,200+ product formats and 200,000 SKUs, with full change auditing and Active
                        Directory integration for per-format image management.
                    </p>
                    <div class="tech-pills">
                        <span class="tech-pill"><i class="devicon-csharp-plain"></i> C#</span>
                        <span class="tech-pill"><i class="devicon-dotnetcore-plain"></i> .NET</span>
                        <span class="tech-pill"><i class="devicon-microsoftsqlserver-plain"></i> SQL Server</span>
                        <span class="tech-pill">Active Directory</span>
                        <span class="tech-pill">Role-Based Access Control</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                        <h4 class="fw-bold mb-0" data-i18n="projects.project3.title">ERP–WMS Load-Date Synchronization System</h4>
                        <span class="status-badge mb-0"><i class="bi bi-briefcase"></i><span data-i18n="projects.origin.work">STN Cerámica</span></span>
                    </div>
                    <p class="text-muted mb-3" data-i18n="projects.project3.description">
                        SQL Server integration layer (triggers + stored procedures) that syncs load-date changes in
                        real time between an external carrier app and the ERP, removing manual coordination for
                        ~1,000 daily goods movements, with automatic alerts on discrepancies.
                    </p>
                    <div class="tech-pills">
                        <span class="tech-pill"><i class="devicon-microsoftsqlserver-plain"></i> SQL Server</span>
                        <span class="tech-pill">T-SQL</span>
                        <span class="tech-pill">Triggers</span>
                        <span class="tech-pill">Stored Procedures</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body pb-4">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                        <h4 class="fw-bold mb-0" data-i18n="projects.project4.title">Automated Report Upload to AWS Wasabi</h4>
                        <span class="status-badge mb-0"><i class="bi bi-briefcase"></i><span data-i18n="projects.origin.work">STN Cerámica</span></span>
                    </div>
                    <p class="text-muted mb-3" data-i18n="projects.project4.description">
                        VB.NET application integrated with SQL Server and AWS Wasabi (S3) that automates the periodic
                        detection, upload, and status tracking of PDF reports, with error handling, retries, and
                        forced manual execution.
                    </p>
                    <div class="tech-pills">
                        <span class="tech-pill"><i class="devicon-visualbasic-plain"></i> VB.NET</span>
                        <span class="tech-pill"><i class="devicon-microsoftsqlserver-plain"></i> SQL Server</span>
                        <span class="tech-pill"><i class="devicon-amazonwebservices-plain"></i> AWS S3 / Wasabi</span>
                        <span class="tech-pill">Async/Await</span>
                        <span class="tech-pill">CancellationToken</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body pb-4">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                        <h4 class="fw-bold mb-0" data-i18n="projects.project5.title">Regulatory Document Automation — DeCA Compliance</h4>
                        <span class="status-badge mb-0"><i class="bi bi-briefcase"></i><span data-i18n="projects.origin.work">STN Cerámica</span></span>
                    </div>
                    <p class="text-muted mb-3" data-i18n="projects.project5.description">
                        VB.NET / .NET Framework console application that automates the generation and publication of regulatory
                        DeCA delivery notes, detecting pending items in SQL Server, generating PDFs with Crystal Reports,
                        uploading them automatically to AWS Wasabi S3, and applying retry logic with status tracking.
                    </p>
                    <div class="tech-pills">
                        <span class="tech-pill"><i class="devicon-visualbasic-plain"></i> VB.NET</span>
                        <span class="tech-pill"><i class="devicon-dotnetcore-plain"></i> .NET Framework</span>
                        <span class="tech-pill"><i class="devicon-microsoftsqlserver-plain"></i> SQL Server</span>
                        <span class="tech-pill">Crystal Reports</span>
                        <span class="tech-pill"><i class="devicon-amazonwebservices-plain"></i> AWS S3 / Wasabi</span>
                        <span class="tech-pill">AWS SDK for .NET</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Other Contributions -->
    <div class="row justify-content-center mt-4">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                        <h4 class="fw-bold mb-0" data-i18n="projects.contributions.title">OTHER CONTRIBUTIONS</h4>
                        <span class="status-badge mb-0"><i class="bi bi-briefcase"></i><span data-i18n="projects.origin.work">STN Cerámica</span></span>
                    </div>
                    <ul class="list-unstyled soft-skills-list mb-3">
                        <li><strong>• <span data-i18n="projects.contributions.li1">Resolution of 1,000+ production incidents in SQL Server and Microsoft Dynamics 365 through agile triage</span></strong></li>
                        <li><strong>• <span data-i18n="projects.contributions.li2">Secure storage architecture on AWS Wasabi with SHA-256 hashing</span></strong></li>
                        <li><strong>• <span data-i18n="projects.contributions.li3">Recurring report generation with SQL Server Management Studio and Crystal Reports</span></strong></li>
                    </ul>
                    <div class="tech-pills">
                        <span class="tech-pill">Microsoft Dynamics 365</span>
                        <span class="tech-pill"><i class="devicon-amazonwebservices-plain"></i> AWS</span>
                        <span class="tech-pill">Crystal Reports</span>
                        <span class="tech-pill">SSMS</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Coming Soon -->
    <div class="row justify-content-center mt-4">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-body text-center">
                    <span class="status-badge" data-i18n="projects.comingsoon.status">IN PROGRESS</span>
                    <div class="d-flex align-items-center justify-content-center flex-wrap gap-2 mb-2 mt-2">
                        <h4 class="fw-bold mb-0" data-i18n="projects.comingsoon.title">COMING SOON</h4>
                        <span class="status-badge status-badge--personal mb-0"><i class="bi bi-person"></i><span data-i18n="projects.origin.personal">Personal Project</span></span>
                    </div>
                    <p class="text-muted mb-0" data-i18n="projects.comingsoon.description">
                        New data-oriented projects — analytics dashboards and machine learning models — are taking
                        shape and will be showcased here as they come together.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Skills Section -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-6 mb-4">
            <div class="card h-100 skill-card" id="languages">
                <div class="card-body">
                    <h4 class="fw-bold text-center mb-4" data-i18n="nav.projects.languages">Languages</h4>
                    <div class="text-center">
                        <div class="mb-4">
                            <img src="~/img/es.jpg" alt="Spanish" class="language-flag mb-2">
                            <h4 class="skill-label" data-i18n="projects.spanish.label">NATIVE</h4>
                        </div>
                        <div class="mb-4">
                            <img src="~/img/gb.jpg" alt="English" class="language-flag mb-2">
                            <h4 class="skill-label" data-i18n="projects.english.label">FULL PROFESSIONAL PROFICIENCY</h4>
                        </div>
                        <div class="mb-0">
                            <img src="~/img/kr.jpg" alt="Korean" class="language-flag mb-2">
                            <h4 class="skill-label" data-i18n="projects.korean.label">CONVERSATIONAL</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100" id="softskills">
                <div class="card-body">
                    <h4 class="fw-bold text-center mb-4" data-i18n="nav.projects.softskills">Soft Skills</h4>
                    <ul class="list-unstyled soft-skills-list mb-0">
                        <li><strong>• <span data-i18n="projects.soft.problemSolving">PROBLEM SOLVING</span></strong></li>
                        <li><strong>• <span data-i18n="projects.soft.logicalThinking">LOGICAL THINKING</span></strong></li>
                        <li><strong>• <span data-i18n="projects.soft.taskOrganization">TASK ORGANIZATION</span></strong></li>
                        <li><strong>• <span data-i18n="projects.soft.triage">INCIDENT TRIAGE & ROOT-CAUSE ANALYSIS</span></strong></li>
                        <li><strong>• <span data-i18n="projects.soft.dataCleaning">DATA CLEANING</span></strong></li>
                        <li><strong>• <span data-i18n="projects.soft.teamwork">TEAMWORK</span></strong></li>
                        <li><strong>• <span data-i18n="projects.soft.continuousLearning">CONTINUOUS LEARNING</span></strong></li>
                        <li><strong>• <span data-i18n="projects.soft.drivingLicense">CAR DRIVING LICENSE</span></strong></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
