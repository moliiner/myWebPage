@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section id="hero">
    <div class="container">
        <div class="row align-items-center">
            <!-- Left Column: Text -->
            <div class="col-lg-7 text-start">
                <h1 class="display-3 fw-bold mb-3">Hello, I'm Javier Moliner</h1>
                <p class="lead mb-4 fs-3">Software Engineer with 2+ years of experience in .NET and SQL.</p>
                <div class="d-flex gap-3 justify-content-start">
                    <a asp-page="/Experience" class="btn btn-light btn-lg fw-bold px-4">View My Work</a>
                </div>
            </div>
            
            <!-- Right Column: Photo and Contact Button -->
            <div class="col-lg-5 text-center">
                <div class="mb-4">
                     <img src="https://placehold.co/250x250" alt="Javier Moliner" class="rounded-circle shadow-lg border border-4 border-white" style="width: 250px; height: 250px; object-fit: cover;">
                </div>
                <div>
                    <a asp-page="/Contact" class="btn btn-outline-light btn-lg fw-bold px-4">CONTACT ME</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Who I am? Section -->
<section class="bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">Who I am?</h2>
                <p class="lead text-muted">
                    I am a passionate software developer dedicated to building robust and efficient web applications. 
                    With over 2 years of experience in the industry, I specialize in .NET technologies and SQL databases, 
                    creating scalable solutions that drive business value.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Where did I study? Section -->
<section class="bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">Where did I study?</h2>
                <p class="lead text-muted">
                    My academic journey began at the <strong>University of Technology</strong>, where I earned my 
                    Bachelor of Science in Computer Science (2015 - 2019). I further honed my practical skills 
                    through an intensive <strong>Full Stack Web Development Bootcamp</strong> at Code Academy in 2020.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- About me Section -->
<section class="bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">About me</h2>
                <p class="lead text-muted">
                    Beyond coding, I am an avid learner who loves exploring new technologies and solving complex problems. 
                    When I'm not at my computer, you can usually find me hiking in the mountains or immersed in a good 
                    sci-fi novel. I believe in continuous improvement and the power of technology to change lives.
                </p>
            </div>
        </div>
    </div>
</section>
