@page
@model SkillsModel
@{
    ViewData["Title"] = "Projects";
}

<!-- Add Devicon CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

<div class="container page-container">
    <h1 class="section-title">PROJECTS &amp; SKILLS</h1>

    <!-- Languages Section -->
    <div class="row justify-content-center text-center mb-5 g-4">
        <div class="col-md-4">
            <div class="card h-100 skill-card">
                <div class="card-body">
                    <img src="~/img/es.jpg" alt="Spanish" class="language-flag mb-3">
                    <h4 class="skill-label">NATIVE</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 skill-card">
                <div class="card-body">
                    <img src="~/img/gb.jpg" alt="English" class="language-flag mb-3">
                    <h4 class="skill-label">FULL PROFESSIONAL PROFICIENCY</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 skill-card">
                <div class="card-body">
                    <img src="~/img/kr.jpg" alt="Korean" class="language-flag mb-3">
                    <h4 class="skill-label">CONVERSATIONAL</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Projects Section -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-body">
                    <h4 class="fw-bold mb-2">AI-Powered Job Search Automation</h4>
                    <p class="text-muted mb-3">
                        Python pipeline that integrates external APIs, uses an LLM to evaluate and score information
                        in a structured way, stores historical results, and presents them in an interactive dashboard
                        with automatic notifications.
                    </p>
                    <div class="tech-pills">
                        <span class="tech-pill"><i class="devicon-python-plain"></i> Python</span>
                        <span class="tech-pill">REST APIs</span>
                        <span class="tech-pill">LLM Integration</span>
                        <span class="tech-pill"><i class="devicon-streamlit-plain"></i> Streamlit</span>
                        <span class="tech-pill">Data Pipelines</span>
                        <span class="tech-pill">Telegram Bot API</span>
                    </div>
                    <a href="https://github.com/moliiner/job_tracker_korea" class="btn btn-outline-primary btn-sm mt-3" target="_blank" rel="noopener noreferrer">EXPLORE</a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="fw-bold mb-2">Product Format Management Tool</h4>
                    <p class="text-muted mb-3">
                        Internal .NET application with role-based access control that securely manages the critical
                        master data of 2,200+ product formats and 200,000 SKUs, with full change auditing and Active
                        Directory integration for per-format image management.
                    </p>
                    <div class="tech-pills">
                        <span class="tech-pill"><i class="devicon-csharp-plain"></i> C#</span>
                        <span class="tech-pill"><i class="devicon-dotnetcore-plain"></i> .NET</span>
                        <span class="tech-pill"><i class="devicon-microsoftsqlserver-plain"></i> SQL Server</span>
                        <span class="tech-pill">Active Directory</span>
                        <span class="tech-pill">Role-Based Access Control</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="fw-bold mb-2">ERP–WMS Load-Date Synchronization System</h4>
                    <p class="text-muted mb-3">
                        SQL Server integration layer (triggers + stored procedures) that syncs load-date changes in
                        real time between an external carrier app and the ERP, removing manual coordination for
                        ~1,000 daily goods movements, with automatic alerts on discrepancies.
                    </p>
                    <div class="tech-pills">
                        <span class="tech-pill"><i class="devicon-microsoftsqlserver-plain"></i> SQL Server</span>
                        <span class="tech-pill">T-SQL</span>
                        <span class="tech-pill">Triggers</span>
                        <span class="tech-pill">Stored Procedures</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Other Contributions -->
    <div class="row justify-content-center mt-4">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">OTHER CONTRIBUTIONS</h4>
                    <ul class="list-unstyled soft-skills-list mb-3">
                        <li><strong>• Resolution of 1,000+ production incidents in SQL Server and Microsoft Dynamics 365 through agile triage</strong></li>
                        <li><strong>• Secure storage architecture on AWS Wasabi with SHA-256 hashing</strong></li>
                        <li><strong>• Recurring report generation with SQL Server Management Studio and Crystal Reports</strong></li>
                    </ul>
                    <div class="tech-pills">
                        <span class="tech-pill">Microsoft Dynamics 365</span>
                        <span class="tech-pill"><i class="devicon-amazonwebservices-plain"></i> AWS</span>
                        <span class="tech-pill">Crystal Reports</span>
                        <span class="tech-pill">SSMS</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Coming Soon -->
    <div class="row justify-content-center mt-4">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-body text-center">
                    <span class="status-badge">IN PROGRESS</span>
                    <h4 class="fw-bold mb-2 mt-2">COMING SOON</h4>
                    <p class="text-muted mb-0">
                        New data-oriented projects — analytics dashboards and machine learning models — are taking
                        shape and will be showcased here as they come together.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Soft Skills Section -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled soft-skills-list">
                                <li><strong>• PROBLEM SOLVING</strong></li>
                                <li><strong>• LOGICAL THINKING</strong></li>
                                <li><strong>• TASK ORGANIZATION</strong></li>  
                                <li><strong>• INCIDENT TRIAGE & ROOT-CAUSE ANALYSIS</strong></li>
                            </ul>
                        </div>
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled soft-skills-list">
                                <li><strong>• DATA CLEANING</strong></li>
                                <li><strong>• TEAMWORK</strong></li>
                                <li><strong>• CONTINUOUS LEARNING</strong></li>
                                <li><strong>• CAR DRIVING LICENSE</strong></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
