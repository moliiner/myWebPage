@page
@model ExperienceModel
@{
    ViewData["Title"] = "Experience";
}

<div class="container">
    <h2 class="section-title">Professional Experience</h2>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="card-title text-primary fw-bold">Java Developer</h4>
                            <h5 class="card-subtitle mb-2 text-muted">PaynoPain Solutions S.L.</h5>
                        </div>
                        <span class="badge bg-primary rounded-pill">Feb 2024 - Jul 2024</span>
                    </div>
                    <p class="card-text mt-3">Main person responsible for the development of Single Sign-On for unified authentication of the company's internal services</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="card-title text-primary fw-bold">Software Engineer</h4>
                            <h5 class="card-subtitle mb-2 text-muted">STN Cerámica</h5>
                        </div>
                        <span class="badge bg-secondary rounded-pill">Sep 2024 - Present</span>
                    </div>
                    <p class="card-text mt-3">SQL and .NET developer responsible for maintaining the company's databases. I implement solutions for the ERP and also resolve technical issues.</p>
                </div>
            </div>
        </div>
    </div>
</div>
