@page
@model ExperienceModel
@{
    ViewData["Title"] = "Experience";
}

<div class="container py-5">
    <h1 class="section-title" data-aos="fade-up">JOB EXPERIENCE</h1>

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Job 1 -->
            <div class="row align-items-center mb-5" data-aos="fade-up">
                <div class="col-md-5 ps-md-5 mb-3 mb-md-0">
                    <h3 class="experience-title"><strong>JAVA DEVELOPER</strong></h3>
                    <div class="experience-company">PaynoPain Solutions S.L.</div>
                    <div class="experience-date">February 2024 - July 2024</div>
                    <a href="https://paynopain.com/" class="explore-btn explore-paynopain btn-animado">EXPLORE</a>
                </div>

                <div class="col-md-7">
                    <div class="row align-items-center experience-description">
                        <div class="col-lg-7">
                            <p>
                                Main person responsible for the development of a Single Sign-On for unified authentication
                                of the company's internal services.
                            </p>
                        </div>
                        <div class="col-lg-5 text-center">
                            <img src="~/img/paynopain.jpg"
                                 alt="PaynoPain"
                                 class="rounded-circle shadow-lg img-fluid"
                                 style="max-width: 200px; aspect-ratio: 1 / 1; object-fit: cover;"
                                 data-aos="zoom-in" data-aos-delay="200">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Arrow -->
            <div class="row my-5" data-aos="fade-up" data-aos-delay="150">
                <div class="col-md-5 ps-md-5 d-flex">
                    <svg class="experience-arrow" width="24" height="64" viewBox="0 0 24 64" fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 0V52" stroke="#6c757d" stroke-width="2" />
                        <path d="M6 46L12 52L18 46" stroke="#6c757d" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <!-- Job 2 -->
            <div class="row align-items-center" data-aos="fade-up">
                <div class="col-md-5 ps-md-5 mb-3 mb-md-0">
                    <h3 class="experience-title"><strong>SOFTWARE ENGINEER</strong></h3>
                    <div class="experience-company">STN Cerámica</div>
                    <div class="experience-date">September 2024 - Present</div>
                    <a href="https://stnceramica.es/" class="explore-btn explore-stn btn-animado">EXPLORE</a>
                </div>

                <div class="col-md-7">
                    <div class="row align-items-center experience-description">
                        <div class="col-lg-7">
                            <p>
                                SQL and .NET developer responsible for maintaining the company's databases.
                                I implement solutions for the ERP and also resolve technical issues.
                            </p>
                        </div>
                        <div class="col-lg-5 text-center">
                            <img src="~/img/stn.jpg"
                                 alt="STN Ceramica"
                                 class="square shadow-lg img-fluid"
                                 style="max-width: 200px; aspect-ratio: 1 / 1; object-fit: cover;"
                                 data-aos="zoom-in" data-aos-delay="200">
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
