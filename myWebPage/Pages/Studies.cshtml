@page
@model StudiesModel
@{
    ViewData["Title"] = "Studies";
}
<div class="container py-5">
    <h1 class="section-title">EDUCATION</h1>

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Job 1 -->
            <div class="row align-items-center mb-5">
                <div class="col-md-5 ps-md-5 mb-3 mb-md-0">
                    <h3 class="studies-title"><strong>COMPUTER ENGINEERING</strong></h3>
                    <div class="studies-company">Universitat Jaume I</div>
                    <div class="studies-date">2019 - 2024</div>
                    <a href="https://www.uji.es/" class="explore-btn explore-paynopain">EXPLORE</a>
                </div>

                <div class="col-md-7">
                    <div class="row align-items-center experience-description">
                        <div class="col-lg-5 text-center">
                            <img src="~/img/uji.png"
                                 alt="UJI"
                                 class="img-fluid uji-logo">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Arrow -->
            <div class="row my-4">
                <div class="col-md-5 ps-md-5">
                    <div class="dashed-arrow"></div>
                </div>
            </div>

            <!-- Job 2 -->
            <div class="row align-items-center">
                <div class="col-md-5 ps-md-5 mb-3 mb-md-0">
                    <h3 class="studies-title"><strong>COMPUTER SCIENCE</strong></h3>
                    <div class="studies-company">Sejong University</div>
                    <div class="studies-date">August 2023 - December 2023</div>
                    <a href="https://en.sejong.ac.kr/eng/index.do" class="explore-btn explore-stn">EXPLORE</a>
                </div>

                <div class="col-md-7">
                    <div class="row align-items-center experience-description">
                        <div class="col-lg-5 text-center">
                            <img src="~/img/sejong.png"
                                 alt="Sejong University"
                                 class="rounded-circle shadow-lg img-fluid"
                                 style="max-width: 200px; aspect-ratio: 1 / 1; object-fit: cover;">
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <hr class="my-5">
    <h1 class="section-title">CERTIFICATIONS</h1>

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Certification 1 -->
