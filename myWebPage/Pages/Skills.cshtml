@page
@model SkillsModel
@{
    ViewData["Title"] = "Skills";
}

<div class="container text-center">
    <h2 class="section-title">Technical Skills</h2>
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card p-4">
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <span class="badge bg-secondary skill-badge">HTML5</span>
                    <span class="badge bg-secondary skill-badge">CSS3</span>
                    <span class="badge bg-warning text-dark skill-badge">JavaScript</span>
                    <span class="badge bg-primary skill-badge">C#</span>
                    <span class="badge bg-info text-dark skill-badge">React</span>
                    <span class="badge bg-success skill-badge">Pyhton</span>
                    <span class="badge bg-dark skill-badge" style="background-color: #6610f2 !important;">ASP.NET Core</span>
                    <span class="badge bg-dark skill-badge">Git</span>
                    <span class="badge bg-info skill-badge">SQL Server</span>
                    <span class="badge bg-primary skill-badge">Azure DevOps</span>
                    <span class="badge bg-success skill-badge">Java</span>
                </div>
            </div>
        </div>
    </div>
</div>
