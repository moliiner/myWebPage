@page
@model SkillsModel
@{
    ViewData["Title"] = "Skills";
}

<!-- Add Devicon CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

<div class="container py-5">
    <h1 class="section-title">SKILLS & KNOWLEDGE</h1>

    <!-- Languages Section -->
    <div class="row justify-content-center text-center mb-5">
        <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="100">
            <img src="~/img/es.jpg" alt="Spanish" class="language-flag mb-3">
            <h4 class="text-uppercase fw-bold">NATIVE</h4>
        </div>
        <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="200">
            <img src="~/img/gb.jpg" alt="English" class="language-flag mb-3">
            <h4 class="text-uppercase fw-bold">ADVANCED</h4>
        </div>
        <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="300">
            <img src="~/img/kr.jpg" alt="Korean" class="language-flag mb-3">
            <h4 class="text-uppercase fw-bold">BASIC</h4>
        </div>
    </div>

    <!-- Technologies Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
            <div class="row text-center row-cols-2 row-cols-md-5 g-4">
                <div class="col" data-aos="fade-up" data-aos-delay="100">
                    <i class="devicon-azuresqldatabase-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">SQL</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="200">
                    <i class="devicon-microsoftsqlserver-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">SQL SERVER</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="300">
                    <i class="devicon-dotnetcore-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">.NET</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="400">
                    <i class="devicon-csharp-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">C#</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="500">
                    <i class="devicon-javascript-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">JAVASCRIPT</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="600">
                    <i class="devicon-html5-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">HTML</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="700">
                    <i class="devicon-css3-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">CSS</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="800">
                    <i class="devicon-visualstudio-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">VISUAL STUDIO</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="900">
                    <i class="devicon-python-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">PYTHON</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="1000">
                    <i class="devicon-java-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">JAVA</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="1100">
                    <i class="devicon-github-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">GITHUB</p>
                </div>
                <div class="col" data-aos="fade-up" data-aos-delay="1200">
                    <i class="devicon-azure-plain colored tech-icon"></i>
                    <p class="mt-2 fw-bold">AZURE</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Soft Skills Section -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="row text-center">
                <div class="col-md-6 mb-3" data-aos="fade-right">
                    <ul class="list-unstyled soft-skills-list">
                        <li><strong>• PROBLEM SOLVING</strong></li>
                        <li><strong>• LOGICAL THINKING</strong></li>
                        <li><strong>• TASK ORGANIZATION</strong></li>
                    </ul>
                </div>
                <div class="col-md-6 mb-3" data-aos="fade-left">
                    <ul class="list-unstyled soft-skills-list">
                        <li><strong>• TEAMWORK</strong></li>
                        <li><strong>• CONTINUOUS LEARNING</strong></li>
                        <li><strong>• CAR DRIVING LICENSE</strong></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
