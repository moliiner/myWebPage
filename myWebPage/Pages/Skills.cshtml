@page
@model SkillsModel
@{
    ViewData["Title"] = "Skills";
}

<!-- Add Devicon CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

<div class="container page-container">
    <h1 class="section-title">SKILLS & KNOWLEDGE</h1>

    <!-- Languages Section -->
    <div class="row justify-content-center text-center mb-5 g-4">
        <div class="col-md-4">
            <div class="card h-100 skill-card">
                <div class="card-body">
                    <img src="~/img/es.jpg" alt="Spanish" class="language-flag mb-3">
                    <h4 class="skill-label">NATIVE</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 skill-card">
                <div class="card-body">
                    <img src="~/img/gb.jpg" alt="English" class="language-flag mb-3">
                    <h4 class="skill-label">FULL PROFESSIONAL PROFICIENCY</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 skill-card">
                <div class="card-body">
                    <img src="~/img/kr.jpg" alt="Korean" class="language-flag mb-3">
                    <h4 class="skill-label">CONVERSATIONAL</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Technologies Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-body">
                    <div class="row text-center row-cols-2 row-cols-md-5 g-4">
                        <div class="col">
                            <i class="devicon-azuresqldatabase-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">SQL</p>
                        </div>
                        <div class="col">
                            <i class="devicon-microsoftsqlserver-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">SQL SERVER</p>
                        </div>
                        <div class="col">
                            <i class="devicon-dotnetcore-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">.NET</p>
                        </div>
                        <div class="col">
                            <i class="devicon-csharp-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">C#</p>
                        </div>
                        <div class="col">
                            <i class="devicon-javascript-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">JAVASCRIPT</p>
                        </div>
                        <div class="col">
                            <i class="devicon-html5-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">HTML</p>
                        </div>
                        <div class="col">
                            <i class="devicon-css3-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">CSS</p>
                        </div>
                        <div class="col">
                            <i class="devicon-visualstudio-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">VISUAL STUDIO</p>
                        </div>
                        <div class="col">
                            <i class="devicon-python-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">PYTHON</p>
                        </div>
                        <div class="col">
                            <i class="devicon-java-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">JAVA</p>
                        </div>
                        <div class="col">
                            <i class="devicon-github-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">GITHUB</p>
                        </div>
                        <div class="col">
                            <i class="devicon-azure-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">AZURE</p>
                        </div>
                        <div class="col">
                            <i class="devicon-react-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">REACT.JS</p>
                        </div>
                        <div class="col">
                            <i class="devicon-amazonwebservices-plain tech-icon"></i>
                            <p class="mt-2 fw-bold">AWS</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Soft Skills Section -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled soft-skills-list">
                                <li><strong>• PROBLEM SOLVING</strong></li>
                                <li><strong>• LOGICAL THINKING</strong></li>
                                <li><strong>• TASK ORGANIZATION</strong></li>  
                                <li><strong>• INCIDENT TRIAGE & ROOT-CAUSE ANALYSIS</strong></li>
                            </ul>
                        </div>
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled soft-skills-list">
                                <li><strong>• DATA CLEANING</strong></li>
                                <li><strong>• TEAMWORK</strong></li>
                                <li><strong>• CONTINUOUS LEARNING</strong></li>
                                <li><strong>• CAR DRIVING LICENSE</strong></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
