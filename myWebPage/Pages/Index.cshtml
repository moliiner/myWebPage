@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section id="hero">
    <div class="container">
        <div class="row align-items-center">
            <!-- Left Column: Text -->
            <div class="col-lg-7 text-start">
                <h1 class="display-3 fw-bold mb-3">Hello, <br>I'm Javier Moliner</h1>
                <p class="lead mb-4 fs-3">Software Engineer with 2+ years of <br>experience in .NET and SQL.</p>
                @* <div class="d-flex gap-3 justify-content-start">
                    <a asp-page="/Experience" class="btn btn-light btn-lg fw-bold px-4">View My Work</a>
                </div> *@
            </div>
            
            <!-- Right Column: Photo and Contact Button -->
            <div class="col-lg-5 text-center">
                <div class="mb-4">
                    <img src="~/img/jmoliner.jpeg" alt="Javier Moliner" class="rounded-circle shadow-lg border border-4 border-white" style="width: 250px; height: 250px; object-fit: cover;">
                </div>
                <div>
                    <a asp-page="/Contact" class="btn btn-light btn-lg fw-bold px-4 contact">CONTACT ME</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Who I am? Section -->
<section class="bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">Who I am?</h2>
                <p class="lead text-muted">
                    Computer engineer with over 2 years of experience as a SQL and .NET developer, managing the company’s databases 
                    through data analysis, transformation, and optimization. Specialized in process automation using stored procedures, 
                    scripts, and services, improving operational efficiency and reducing repetitive manual tasks. Committed to 
                    ensuring data integrity and delivering stable, scalable solutions aligned with business needs.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Where did I study? Section -->
<section class="bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">Where did I study?</h2>
                <p class="lead text-muted">
                    I studied Computer Engineering for four years at <strong>Universitat Jaume I (Spain)</strong>, where 
                    I developed a strong technical and analytical foundation. In addition, I participated in an international 
                    exchange program at <strong>Sejong University (South Korea)</strong> for four months, an experience that 
                    broadened my academic and cultural perspective and strengthened my skills in an international environment.

                </p>
            </div>
        </div>
    </div>
</section>

<!-- About me Section -->
<section class="bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">About me</h2>
                <p class="lead text-muted">
                    I am a person who is passionate about technology and everything related to digital innovation. I am 
                    also deeply interested in Asian culture, especially its language, traditions, and ways of thinking, 
                    as well as cinema, which I consider one of the best ways to explore different perspectives and emotions. 
                    In my free time, I play rugby, a sport I value for its teamwork, discipline, and camaraderie.
                </p>
            </div>
        </div>
    </div>
</section>
