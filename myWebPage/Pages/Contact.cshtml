@page
@model ContactModel
@{
    ViewData["Title"] = "Contact";
}

<div class="container page-container">
    <h1 class="section-title" data-i18n="contact.title">CONTACT ME</h1>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body p-4">
                    <form id="contactForm">
                        <div class="mb-3">
                            <label for="name" class="form-label" data-i18n="contact.label.name">Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Your Name" data-i18n-placeholder="contact.placeholder.name" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label" data-i18n="contact.label.email">Email</label>
                            <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label" data-i18n="contact.label.message">Message</label>
                            <textarea class="form-control" id="message" rows="5" placeholder="Your Message" data-i18n-placeholder="contact.placeholder.message" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 btn-lg" data-i18n="contact.submit">Send Message</button>
                    </form>
                </div>
            </div>
            <div class="text-center mt-4">
                <p class="text-muted" data-i18n="contact.direct">Or email me directly at:</p>
                <a href="mailto:jamolnav@gmail.com" class="fs-5 text-decoration-none fw-bold">jamolnav@gmail.com</a>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('contactForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        var name = document.getElementById('name').value;
        var email = document.getElementById('email').value;
        var message = document.getElementById('message').value;
        
        // Subject: Name
        // Body: Message (plus the email for reference)
        var subject = name;
        var body = message + "\n\n(Contact Email: " + email + ")";

        var gmailUrl = "https://mail.google.com/mail/?view=cm&fs=1"
            + "&to=" + encodeURIComponent("jamolnav@gmail.com")
            + "&su=" + encodeURIComponent(subject)
            + "&body=" + encodeURIComponent(body);

        window.open(gmailUrl, '_blank');
    });
</script>
