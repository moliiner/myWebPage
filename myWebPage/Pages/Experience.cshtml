@page
@model ExperienceModel
@{
    ViewData["Title"] = "Experience";
}

<div class="container">
    <h2 class="section-title">Professional Experience</h2>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="card-title text-primary fw-bold">Senior Web Developer</h4>
                            <h5 class="card-subtitle mb-2 text-muted">Tech Corp</h5>
                        </div>
                        <span class="badge bg-primary rounded-pill">2021 - Present</span>
                    </div>
                    <p class="card-text mt-3">Leading the frontend team, developing scalable React applications, and mentoring junior developers. Responsible for architectural decisions and code quality.</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="card-title text-primary fw-bold">Web Developer</h4>
                            <h5 class="card-subtitle mb-2 text-muted">Creative Agency</h5>
                        </div>
                        <span class="badge bg-secondary rounded-pill">2019 - 2021</span>
                    </div>
                    <p class="card-text mt-3">Developed responsive websites for various clients using HTML, CSS, JavaScript, and PHP. Collaborated closely with designers to implement pixel-perfect UIs.</p>
                </div>
            </div>
        </div>
    </div>
</div>
