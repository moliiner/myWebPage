@page
@model StudiesModel
@{
    ViewData["Title"] = "Studies";
}
<div class="container page-container">
    <h1 class="section-title" id="education" data-i18n="studies.title">EDUCATION</h1>

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Study 1 -->
            <div class="card experience-card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-5 mb-4 mb-md-0">
                            <h3 class="studies-title" data-i18n="studies.uji.title">COMPUTER ENGINEERING</h3>
                            <div class="studies-company">Universitat Jaume I (Castellon)</div>
                            <div class="studies-date">2019 - 2024</div>
                            <a href="https://www.uji.es/" class="btn btn-outline-primary btn-sm" data-i18n="common.explore">EXPLORE</a>
                        </div>

                        <div class="col-md-7">
                            <div class="row align-items-center experience-description">
                                <div class="col-lg-5 text-center mb-4 mb-lg-0">
                                    <img src="~/img/uji.png" alt="UJI" class="avatar-logo-square">
                                </div>
                                <div class="col-lg-7">
                                    <p class="mb-0" data-i18n="studies.uji.description">
                                        During my time at the university, I learned numerous technologies and how to use 
                                        them to make the most of them. Additionally, I spent 4 years on the university 
                                        rugby's team, where I learned the value of effort and teamwork.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Arrow -->
            <div class="row my-4">
                <div class="col-md-5 d-flex justify-content-center justify-content-md-start ps-md-4">
                    <svg class="experience-arrow" width="24" height="64" viewBox="0 0 24 64" fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 0V52" stroke="#6c757d" stroke-width="2" />
                        <path d="M6 46L12 52L18 46" stroke="#6c757d" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <!-- Study 2 -->
            <div class="card experience-card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-5 mb-4 mb-md-0">
                            <h3 class="studies-title" data-i18n="studies.sejong.title">COMPUTER SCIENCE</h3>
                            <div class="studies-company">Sejong University (Seoul)</div>
                            <div class="studies-date">August 2023 - December 2023</div>
                            <a href="https://en.sejong.ac.kr/eng/index.do" class="btn btn-outline-primary btn-sm" data-i18n="common.explore">EXPLORE</a>
                        </div>

                        <div class="col-md-7">
                            <div class="row align-items-center experience-description">
                                <div class="col-lg-5 text-center mb-4 mb-lg-0">
                                    <img src="~/img/sejong.png" alt="Sejong University" class="avatar-logo">
                                </div>
                                <div class="col-lg-7">
                                    <p class="mb-0" data-i18n="studies.sejong.description">
                                        I was an exchange student in South Korea (Seoul) and I learned about part 
                                        of their culture and to take on more responsibilities. It was a great 
                                        experience and it left a lasting impact on me.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <hr class="my-5">
    <h1 class="section-title" id="certifications" data-i18n="certifications.title">CERTIFICATIONS</h1>

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Certification 1 -->
            <div class="card experience-card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-4 mb-md-0">
                            <h3 class="studies-title">
                                Google Advanced Data Analytics - Professional Certificate
                            </h3>
                            <div class="studies-company">Coursera</div>
                            <a href="https://www.coursera.org/professional-certificates/google-advanced-data-analytics" class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer" data-i18n="certifications.google.view">View Certification</a>
                        </div>

                        <div class="col-md-4 text-center mb-4 mb-md-0">
                            <img src="~/img/google.png" alt="Google" class="avatar-logo">
                        </div>

                        <div class="col-md-4">
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <span class="status-badge mb-0" data-i18n="certifications.google.status">(in progress)</span>
                                <span class="status-badge mb-0" data-i18n="certifications.google.progress">2/7 courses completed</span>
                            </div>
                            <div class="cert-progress mt-2" role="progressbar" aria-valuenow="29" aria-valuemin="0" aria-valuemax="100" aria-label="Certification progress">
                                <div class="cert-progress--bar" style="width: 29%;"></div>
                            </div>
                            <p class="text-muted mt-3 mb-3" data-i18n="certifications.google.description">
                                Covers advanced data analysis with Python, SQL, and applied machine learning.
                            </p>
                            <p class="cert-list--label mb-2" data-i18n="certifications.google.certs">Certificates</p>
                            <div class="cert-list">
                                <a href="https://www.coursera.org/account/accomplishments/records/WBLOEZLNJ04F" class="cert-list--item" target="_blank" rel="noopener noreferrer">
                                    <i class="bi bi-award"></i>Foundations of Data Science
                                </a>
                                <a href="https://www.coursera.org/account/accomplishments/records/5AY2E94E6Q91" class="cert-list--item" target="_blank" rel="noopener noreferrer">
                                    <i class="bi bi-award"></i>Go Beyond the Numbers: Translate Data into Insights
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
