@page
@model StudiesModel
@{
    ViewData["Title"] = "Studies";
}

<div class="container">
    <h2 class="section-title">Education & Certifications</h2>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="card-title fw-bold">Bachelor of Science in Computer Science</h4>
                            <h6 class="card-subtitle text-muted">University of Technology</h6>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-info text-dark">2015 - 2019</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="card-title fw-bold">Full Stack Web Development Bootcamp</h4>
                            <h6 class="card-subtitle text-muted">Code Academy</h6>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-info text-dark">2020</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
